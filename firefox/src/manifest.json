{
  "manifest_version": 3,
  "name": "Tiphys Köprüsü",
  "version": "0.1.0",
  "description": "Firefox sekmelerini yerel ileti ile Tiphys ajanına (ve telefona) bağlar. Ağ isteği yapmaz.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@tiphys.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "incognito": "not_allowed",
  "permissions": ["tabs", "sessions", "nativeMessaging"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": { "default_title": "Tiphys Köprüsü", "default_popup": "popup/popup.html", "default_icon": "icons/icon.svg" },
  "options_ui": { "page": "popup/popup.html", "open_in_tab": true },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
