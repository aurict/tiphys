<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer are off: Keystore keys cannot be opened on another
     device, and half-migrated data breaks the app. To migrate, use Settings › Profile › encrypted backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
