{
  "name": "tiphys-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Tiphys agent: the per-machine service the Tiphys phone app talks to (Claude Code, system, services, desktop control, monitoring).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tiphys-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "npm run build && node dist/cli.js schema > ../schema/tiphys.schema.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.4",
    "systeminformation": "^5.33.22",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurict/tiphys.git",
    "directory": "agent"
  }
}
