{
  "$id": "https://tiphys.local/schema/tiphys.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "tiphys-profile"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "exportedFrom": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "properties": {
        "theme": {
          "default": "system",
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "language": {
          "default": "system",
          "type": "string",
          "enum": [
            "system",
            "tr",
            "en"
          ]
        },
        "lock": {
          "default": {
            "biometric": true,
            "pin": true,
            "autoLockSeconds": 60
          },
          "type": "object",
          "properties": {
            "biometric": {
              "default": true,
              "type": "boolean"
            },
            "pin": {
              "default": true,
              "type": "boolean"
            },
            "autoLockSeconds": {
              "default": 60,
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        },
        "home": {
          "default": {
            "cards": [
              "infra",
              "claude",
              "system",
              "grafana",
              "dozzle",
              "quickAccess"
            ],
            "tabs": [
              "home",
              "claude",
              "terminal",
              "files",
              "system"
            ],
            "layout": "cards",
            "shortcuts": [
              "terminal",
              "files",
              "quickNote",
              "homepage"
            ]
          },
          "type": "object",
          "properties": {
            "cards": {
              "default": [
                "infra",
                "claude",
                "system",
                "grafana",
                "dozzle",
                "quickAccess"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "infra",
                  "claude",
                  "system",
                  "grafana",
                  "dozzle",
                  "quickAccess",
                  "events",
                  "nowPlaying"
                ]
              }
            },
            "tabs": {
              "default": [
                "home",
                "claude",
                "terminal",
                "files",
                "system"
              ],
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "home",
                  "claude",
                  "terminal",
                  "files",
                  "system"
                ]
              }
            },
            "layout": {
              "default": "cards",
              "type": "string",
              "enum": [
                "cards",
                "grid",
                "focus"
              ]
            },
            "shortcuts": {
              "default": [
                "terminal",
                "files",
                "quickNote",
                "homepage"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "terminal",
                  "files",
                  "quickNote",
                  "homepage",
                  "vault",
                  "desktop",
                  "liveScreen",
                  "media",
                  "openOnPc",
                  "newClaude",
                  "schedules",
                  "events",
                  "compose",
                  "logs",
                  "backups",
                  "dozzle",
                  "grafana",
                  "sites",
                  "wake"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "kebab-case kimlik"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "color": {
            "default": "#8F88EE",
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "ssh": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "port": {
                    "default": 22,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "auth": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "key"
                          },
                          "keyRef": {
                            "type": "string",
                            "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                            "description": "Telefon kasasındaki gizli bilgiye başvuru"
                          }
                        },
                        "required": [
                          "type",
                          "keyRef"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "password"
                          },
                          "passwordRef": {
                            "type": "string",
                            "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                            "description": "Telefon kasasındaki gizli bilgiye başvuru"
                          }
                        },
                        "required": [
                          "type",
                          "passwordRef"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "tmuxSession": {
                    "default": "tiphys",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  }
                },
                "required": [
                  "user",
                  "auth"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "agent": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https?:\\/\\/\\S+$"
                  },
                  "tokenRef": {
                    "type": "string",
                    "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                    "description": "Telefon kasasındaki gizli bilgiye başvuru"
                  }
                },
                "required": [
                  "url",
                  "tokenRef"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "wake": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "mac": {
                    "type": "string",
                    "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
                  },
                  "viaHostId": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                        "description": "kebab-case kimlik"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "mac"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            }
          },
          "composeRoots": {
            "default": [
              "~/stack"
            ],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "required": [
          "id",
          "name",
          "address"
        ],
        "additionalProperties": false
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "kebab-case kimlik"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "ssh-ed25519",
              "ssh-rsa",
              "ecdsa-sha2-nistp256",
              "ecdsa-sha2-nistp384",
              "ecdsa-sha2-nistp521"
            ]
          },
          "publicKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16384
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "publicKey"
        ],
        "additionalProperties": false
      }
    },
    "claude": {
      "type": "object",
      "properties": {
        "agentHostId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "description": "kebab-case kimlik"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaults": {
          "default": {
            "model": "claude-opus-5-5",
            "effort": "high",
            "permissionMode": "bypassPermissions",
            "profileId": "personal"
          },
          "type": "object",
          "properties": {
            "model": {
              "default": "claude-opus-5-5",
              "type": "string"
            },
            "effort": {
              "default": "high",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "permissionMode": {
              "default": "bypassPermissions",
              "type": "string",
              "enum": [
                "default",
                "acceptEdits",
                "plan",
                "bypassPermissions"
              ]
            },
            "profileId": {
              "default": "personal",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "description": "kebab-case kimlik"
            }
          },
          "additionalProperties": false
        },
        "profiles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "description": "kebab-case kimlik"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "configDir": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "name",
              "configDir"
            ],
            "additionalProperties": false
          }
        },
        "favoriteFolders": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "pinnedCommands": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/\\S+$"
          }
        },
        "notify": {
          "default": {
            "done": true,
            "waiting": true,
            "error": true
          },
          "type": "object",
          "properties": {
            "done": {
              "default": true,
              "type": "boolean"
            },
            "waiting": {
              "default": true,
              "type": "boolean"
            },
            "error": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "grafana": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "description": "kebab-case kimlik"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/\\S+$"
              },
              "auth": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "token"
                      },
                      "tokenRef": {
                        "type": "string",
                        "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                        "description": "Telefon kasasındaki gizli bilgiye başvuru"
                      }
                    },
                    "required": [
                      "type",
                      "tokenRef"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "none"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "defaultDashboardUid": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "favorites": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refreshSeconds": {
                "default": 30,
                "type": "integer",
                "minimum": 0,
                "maximum": 3600
              },
              "defaultRange": {
                "default": "now-1h",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "auth"
            ],
            "additionalProperties": false
          }
        },
        "dozzle": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "description": "kebab-case kimlik"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/\\S+$"
              },
              "auth": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "none"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "basic"
                      },
                      "username": {
                        "type": "string",
                        "minLength": 1
                      },
                      "passwordRef": {
                        "type": "string",
                        "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                        "description": "Telefon kasasındaki gizli bilgiye başvuru"
                      }
                    },
                    "required": [
                      "type",
                      "username",
                      "passwordRef"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "auth"
            ],
            "additionalProperties": false
          }
        },
        "homepage": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "browserUrl": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "agentFile"
                    },
                    "hostId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                      "description": "kebab-case kimlik"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "type",
                    "hostId",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "openIn": {
                  "default": "external",
                  "type": "string",
                  "enum": [
                    "external",
                    "inApp"
                  ]
                }
              },
              "required": [
                "browserUrl",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "uptimeKuma": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "viaHostId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "description": "kebab-case kimlik"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                "defaults": {
                  "default": {
                    "intervalSeconds": 60,
                    "alertAfterSeconds": 120,
                    "certExpiryDays": 14
                  },
                  "type": "object",
                  "properties": {
                    "intervalSeconds": {
                      "default": 60,
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 86400
                    },
                    "alertAfterSeconds": {
                      "default": 120,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400
                    },
                    "certExpiryDays": {
                      "default": 14,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 365
                    }
                  },
                  "additionalProperties": false
                },
                "notifyOnRecovery": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "viaHostId",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ntfy": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                "tokenRef": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                      "description": "Telefon kasasındaki gizli bilgiye başvuru"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "topics": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "scriberr": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                "apiKeyRef": {
                  "type": "string",
                  "pattern": "^secret:[a-z0-9][a-z0-9-]{0,62}$",
                  "description": "Telefon kasasındaki gizli bilgiye başvuru"
                },
                "language": {
                  "default": "tr",
                  "type": "string",
                  "enum": [
                    "tr",
                    "en",
                    "auto"
                  ]
                },
                "model": {
                  "default": "small",
                  "type": "string",
                  "enum": [
                    "small",
                    "large-v3"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "obsidian": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "vault": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "folder": {
                  "default": "Gelen kutusu",
                  "type": "string",
                  "maxLength": 500
                },
                "mode": {
                  "default": "newNote",
                  "type": "string",
                  "enum": [
                    "newNote",
                    "dailyNote"
                  ]
                },
                "dailyNotePath": {
                  "default": "Günlük/YYYY-MM-DD",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "vault"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "properties": {
        "fontSize": {
          "default": 13,
          "type": "number",
          "minimum": 8,
          "maximum": 32
        },
        "theme": {
          "default": "tiphys",
          "type": "string"
        },
        "extraKeys": {
          "default": [
            "esc",
            "tab",
            "ctrl",
            "alt",
            "up",
            "down",
            "left",
            "right",
            "|",
            "~",
            "/"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        },
        "snippets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "hostId": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                    "description": "kebab-case kimlik"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "bookmarks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "description": "kebab-case kimlik"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "hostId",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "showHidden": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
